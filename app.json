{
  "expo": {
    "name": "GRRR_Care_Mobile",
    "slug": "GRRR_Care_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grrrcaremobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby veterinary clinics and pet services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to show nearby veterinary clinics and pet services."
      }
    },
    "android": {
      "package": "com.aharroui.grrrccare",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GRRR Care uses your photos for your pet's picture and to attach official documents.",
          "cameraPermission": "GRRR Care uses the camera to take your pet's picture and scan official documents.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "health"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CareHealth",
              "label": "Santé de mon compagnon",
              "description": "Score santé et prochain soin à prévoir",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CareToday",
              "label": "Soins du jour",
              "description": "Traitements, vaccins et rendez-vous à venir",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d8622ce-f01f-4d35-8779-8e6cf992d606"
      }
    },
    "owner": "aharroui"
  }
}
